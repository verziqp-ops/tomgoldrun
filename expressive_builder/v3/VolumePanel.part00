/** Compact Pixel-like global volume overlay with optional Expressive shapes. */
data class VolumePanelSettings(
    val enabled: Boolean = true,
    val style: String = "PIXEL", // PIXEL | EXPRESSIVE
    val colorMode: String = "SYSTEM", // SYSTEM | KEYBOARD | CUSTOM
    val shapePreset: String = ExpressiveShapePreset.COOKIE_12.id,
    val waveCount: Int = 12,
    val waveDepthPercent: Float = 6f,
    val position: String = "RIGHT",
    val widthDp: Float = 62f,
    val heightDp: Float = 290f,
    val trackWidthDp: Float = 30f,
    val cornerDp: Float = 31f,
    val sideOffsetDp: Float = 10f,
    val verticalOffsetDp: Float = 0f,
    val opacity: Float = 0.96f,
    val timeoutMs: Int = 1750,
    val showPercent: Boolean = false,
    val animate: Boolean = true,
    val haptic: Boolean = true,
    val backgroundColor: Int = 0,
    val accentColor: Int = 0,
    val muteSvg: String = "",
    val mediaSvg: String = "",
    val settingsSvg: String = ""
)

object VolumePanelPrefs {
    private const val PREFS = "expressive_volume_panel_v2"
    private const val SCHEMA = 3
    private val state = mutableStateOf(VolumePanelSettings())
    private var listener: SharedPreferences.OnSharedPreferenceChangeListener? = null

    private fun prefs(context: Context): SharedPreferences =
        context.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)

    fun ensureInit(context: Context) {
        if (listener != null) return
        val p = prefs(context)
        migrate(p)
        state.value = read(p)
        val l = SharedPreferences.OnSharedPreferenceChangeListener { sp, _ -> state.value = read(sp) }
        listener = l
        p.registerOnSharedPreferenceChangeListener(l)
    }

    private fun migrate(p: SharedPreferences) {
        val version = p.getInt("schema_version", 0)
        if (version >= SCHEMA) return
        val preset = ExpressiveShapePreset.fromId(
            p.getString("shape_preset", ExpressiveShapePreset.COOKIE_12.id)
                ?: ExpressiveShapePreset.COOKIE_12.id
        )
        // v2 was visually much too wide. Reset only geometry; keep the user's theme/side choices.
        p.edit()
            .putInt("schema_version", SCHEMA)
            .putFloat("width_dp", 62f)
            .putFloat("height_dp", 290f)
            .putFloat("track_width_dp", 30f)
            .putFloat("corner_dp", 31f)
            .putFloat("opacity", 0.96f)
            .putInt("wave_count", preset.defaultWaves)
            .putFloat("wave_depth_percent", preset.defaultAmplitude)
            .apply()
    }

    fun current(context: Context): VolumePanelSettings {
        ensureInit(context)
        return state.value
    }

    @Composable
   